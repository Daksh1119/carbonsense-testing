# =============================================================================
# CarbonSense Frontend — Environment Variables
# =============================================================================
# COPY this file to .env.local and fill in your real values.
# NEVER commit .env.local — it is gitignored.
# =============================================================================

# --- Supabase (Next.js public vars — sent to browser) ---
# Project URL from: Supabase Dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Anon key — used client-side (public, but still keep out of git)
# Supabase Dashboard > Settings > API > Project API keys > anon / public
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key — BACKEND / API ROUTES ONLY. Never use in client components.
# Supabase Dashboard > Settings > API > Project API keys > service_role
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- SMS OTP (optional — pick one provider) ---

# Option 1: Fast2SMS (recommended for India, free tier available)
# Sign up at https://www.fast2sms.com > Dashboard > Dev API > copy key
FAST2SMS_API_KEY=your-fast2sms-api-key-here

# Option 2: Twilio (international)
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
