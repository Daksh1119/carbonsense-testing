# =============================================================================
# CarbonSense — Backend Environment Variables
# =============================================================================
# COPY this file to .env and fill in your real values.
# NEVER commit .env — it is gitignored.
# =============================================================================

# --- Supabase ---
# Project URL from: Supabase Dashboard > Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co

# Anon (public) key — safe to expose to browser, but still keep out of git
# Supabase Dashboard > Settings > API > Project API keys > anon / public
SUPABASE_ANON_KEY=your-anon-key-here

# Service role key — NEVER expose to browser/client. Backend only.
# Supabase Dashboard > Settings > API > Project API keys > service_role
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- Test org / user seeds (local dev only) ---
ORG_A=your-org-a-uuid
ORG_B=your-org-b-uuid

# Org A users
ADMIN_A_EMAIL=admin.a@carbonsense.test
ADMIN_A_PASSWORD=change-me

MANAGER_A_EMAIL=manager.a@carbonsense.test
MANAGER_A_PASSWORD=change-me

ANALYST_A_EMAIL=analyst.a@carbonsense.test
ANALYST_A_PASSWORD=change-me

VIEWER_A_EMAIL=viewer.a@carbonsense.test
VIEWER_A_PASSWORD=change-me

# Org B users — required for cross-org RLS isolation tests (verify_rls.py)
# Create these in Supabase with role=manager/viewer scoped to ORG_B
MANAGER_B_EMAIL=manager.b@carbonsense.test
MANAGER_B_PASSWORD=change-me

VIEWER_B_EMAIL=viewer.b@carbonsense.test
VIEWER_B_PASSWORD=change-me

# --- LLM Provider ---
# Supported: openrouter, openai
LLM_PROVIDER=openrouter
LLM_API_KEY=your-llm-api-key-here
LLM_API_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openrouter/auto
LLM_SITE_URL=http://localhost:3000
LLM_APP_NAME=CarbonSense

# --- Plantation Verification (Satellite Imagery) ---
# Copernicus Data Space Ecosystem (CDSE) — Sentinel Hub OAuth2 client credentials
# Create at: https://dataspace.copernicus.eu/ → OAuth Clients
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
CDSE_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
CDSE_SH_BASE_URL=https://sh.dataspace.copernicus.eu

# Plantation feature constants (defaults shown — only override if needed)
PLANTATION_FY_START_MONTH=4
PLANTATION_MIN_PHOTOS=1
PLANTATION_MAX_PHOTOS=6
PLANTATION_DENSITY_WARN_PER_HA=3000
PLANTATION_PHOTO_MAX_DISTANCE_M=1000
PLANTATION_OVERLAP_RADIUS_M=100

