# =============================================================================
# CarbonSense — .gitignore
# =============================================================================

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/

# Virtual environments
venv/
.venv/
env/

# =============================================================================
# Environment / secrets — NEVER commit real .env files
# Safe to commit ONLY: .env.example  (placeholder values, no real secrets)
# =============================================================================
.env
.env.*
!.env.example
!**/.env.example

# All .local variants anywhere in the tree
.env.local
.env.*.local
**/.env.local
**/.env.*.local

# Explicit frontend paths (belt-and-suspenders)
CarbonSense_FrontEnd/frontend/.env
CarbonSense_FrontEnd/frontend/.env.*
!CarbonSense_FrontEnd/frontend/.env.example

# direnv / dotenv-vault
.envrc
.env.vault

# Common secret file names
secrets.json
secrets.yaml
secrets.yml
service-account*.json
*-service-account.json

# =============================================================================
# OS / IDE
# =============================================================================
.DS_Store
Thumbs.db
.vscode/
.idea/

# Logs
*.log

# =============================================================================
# Supabase
# =============================================================================
supabase/.temp/
supabase/migrations_backup/

# =============================================================================
# Node / Next.js
# =============================================================================
.next/
.turbo/
.cache/
out/
node_modules/

# Lock files (keep package.json, ignore lock files to avoid conflicts)
package-lock.json
yarn.lock
pnpm-lock.yaml
.npmrc
.yarnrc
.yarn/

# =============================================================================
# ML model artifacts (regenerate via: python scripts/train_teme_survival_v4.py)
# =============================================================================
packages/ml_services/teme/ml/models/*.joblib
models/*.pt
models/*.pth

# =============================================================================
# Local dev / debug outputs
# =============================================================================
scripts/ocr_result_*.json
